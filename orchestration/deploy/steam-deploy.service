[Unit]
Description=Pull-based deploy of steam-pipeline from origin/main
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/home/ubuntu/.config/steam-pipeline.env
ExecStart=/home/ubuntu/steam-pipeline/orchestration/deploy/pull-deploy.sh
TimeoutStartSec=20min